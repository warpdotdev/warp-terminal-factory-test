#!/usr/bin/env python3
"""Request a maintainer's review on a PR — only if the factory's own review approved.

Usage: request-owner-review <owner/repo> <pr-number> --bot <factory-bot-login> --owner <owner-login>

Deterministic escalation gate:
  1. Finds the latest review authored by the factory bot on the PR.
  2. If that review is not APPROVED or a COMMENTED review containing the
     `Verdict: accepted` marker, prints BLOCKED and exits 2. No reviewer
     is requested. Do not work around this by calling gh directly.
  3. If approved, requests the exact owner previously resolved by the
     `find-owner` skill.

Exit codes: 0 requested, 2 blocked (verdict not approving), 3 no owner match,
4 no factory review found, 1 usage/API error.
"""
import argparse
import json
import re
import subprocess
import sys


def gh(*args):
    res = subprocess.run(["gh", *args], capture_output=True, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"gh {' '.join(args)} failed: {res.stderr.strip()}")
    return res.stdout



def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("repo")
    ap.add_argument("pr", type=int)
    ap.add_argument("--bot", required=True, help="factory bot login, without [bot] suffix")
    ap.add_argument("--owner", required=True, help="owner login resolved by the find-owner skill")
    args = ap.parse_args()

    pr = json.loads(gh("pr", "view", str(args.pr), "--repo", args.repo,
                       "--json", "reviews,author"))
    bot_names = {args.bot, f"{args.bot}[bot]", "app/" + args.bot}
    factory_reviews = [r for r in pr.get("reviews", [])
                       if (r.get("author") or {}).get("login") in bot_names]
    if not factory_reviews:
        print("NO_FACTORY_REVIEW: the factory has not reviewed this PR yet; escalation is not allowed.")
        return 4
    latest = factory_reviews[-1]
    state = latest.get("state", "")
    body = latest.get("body", "") or ""
    accepted = state == "APPROVED" or (
        state == "COMMENTED" and re.search(r"verdict[:*\s]+accepted", body, re.IGNORECASE)
    )
    if not accepted:
        print(f"BLOCKED: latest factory review verdict is {state} without an accepted verdict. "
              "No maintainer review may be requested on this pass.")
        return 2

    owner = args.owner.lstrip("@")
    author = (pr.get("author") or {}).get("login", "")
    if not owner or "/" in owner or owner.lower() == author.lower():
        print("NO_MATCH: the resolved owner is empty, a team handle, or the PR author.")
        return 3
    gh("pr", "edit", str(args.pr), "--repo", args.repo, "--add-reviewer", owner)
    print(f"REQUESTED: review requested from {owner} (verdict accepted).")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RuntimeError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
