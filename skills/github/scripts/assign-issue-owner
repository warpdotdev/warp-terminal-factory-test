#!/usr/bin/env python3
"""Assign the routed owner to an issue; signal when a mention fallback is needed.

Usage: assign-issue-owner <owner/repo> <issue-number> <owner-login>

Deterministic hand-off used after find-owner routing. Refuses to route issues
carrying `needs-info`, `duplicate`, or a support-escalation label. Otherwise it
tries to set the owner as the issue assignee. Team handles (containing '/') and
non-collaborators cannot be assignees; in those cases this exits 2 and the
caller falls back to the routing mention only.

Exit codes: 0 assigned, 2 not assignable (use the mention fallback),
3 issue ineligible for routing (do not assign or mention), 1 error.
"""
import json
import subprocess
import sys


def main():
    if len(sys.argv) != 4:
        print(__doc__, file=sys.stderr)
        return 1
    repo, issue, owner = sys.argv[1], sys.argv[2], sys.argv[3].lstrip("@")
    view = subprocess.run(
        ["gh", "issue", "view", issue, "--repo", repo, "--json", "labels"],
        capture_output=True, text=True,
    )
    if view.returncode != 0:
        print(f"ERROR: {view.stderr.strip()}", file=sys.stderr)
        return 1
    labels = {label["name"] for label in json.loads(view.stdout).get("labels", [])}
    blocked = labels & {"needs-info", "duplicate", "needs-support"}
    blocked.update(label for label in labels if label.endswith(":needs-support"))
    if blocked:
        print("INELIGIBLE: issue carries routing-blocking label(s): "
              + ", ".join(sorted(blocked))
              + ". Do not assign or mention an owner.")
        return 3
    if "/" in owner:
        print(f"NOT_ASSIGNABLE: {owner} is a team handle; teams cannot be issue assignees. Use the routing mention.")
        return 2
    res = subprocess.run(
        ["gh", "issue", "edit", issue, "--repo", repo, "--add-assignee", owner],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        print(f"NOT_ASSIGNABLE: could not assign {owner} ({res.stderr.strip()}). Use the routing mention.")
        return 2
    print(f"ASSIGNED: {owner} is now an assignee on {repo}#{issue}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
